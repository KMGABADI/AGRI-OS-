PORT=3001
# Local SQLite database path. Keep private and back it up before deployment.
RIFAN_DB_PATH=.data/rifan.sqlite
# Optional: enables the isolated sample workspace in production. Disabled by default.
ENABLE_DEMO=false
# Optional Gemini advisor integration; enter the real key securely at runtime.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Google Workspace: use an OAuth Web application client (not an API key).
# Copy the exact callback URI from Connections into Google Cloud; see docs/GOOGLE_CONNECTION.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://your-rifan-domain.example
# Branded OTP email: configure ONE provider with real runtime credentials.
# RESEND_API_KEY=
# EMAIL_FROM=RIFAN Connect <security@your-verified-domain.example>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=RIFAN Connect <security@your-verified-domain.example>
# Paystack secret is required at runtime, including for local webhook signature checks.
# PAYSTACK_SECRET_KEY=
# PostgreSQL production (DigitalOcean Managed PostgreSQL). Never commit real values.
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/rifan?sslmode=verify-full
# DATABASE_CA_CERT=PASTE_THE_DIGITALOCEAN_CA_CERTIFICATE_IN_SECURE_ENVIRONMENT_SETTINGS
# DATABASE_AUTO_MIGRATE=false
# DATABASE_POOL_MAX=10
# Privileged connection for migration tooling only; keep it out of the web service.
# DATABASE_MIGRATION_URL=
# Persistent initial administrator. A migrated account is never reset on startup.
# BOOTSTRAP_ADMIN_EMAIL=admin@rifan.local
# BOOTSTRAP_ADMIN_PASSWORD=
# DigitalOcean provisioning tooling; token is supplied securely, never in source.
# DIGITALOCEAN_ACCESS_TOKEN=
# DO_DATABASE_TRUSTED_CIDRS=APPROVED_RENDER_OUTBOUND_CIDRS_AND_MIGRATION_HOST_IP
# DO_DATABASE_REGION=lon1
# DO_DATABASE_SIZE=db-s-1vcpu-2gb
# DO_DATABASE_NODES=1
