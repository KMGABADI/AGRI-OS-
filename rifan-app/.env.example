PORT=3001
# Local SQLite database path. Keep private and back it up before deployment.
RIFAN_DB_PATH=.data/rifan.sqlite
# Optional: enables the isolated sample workspace in production. Disabled by default.
ENABLE_DEMO=false
# Optional Gemini advisor integration; enter the real key securely at runtime.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Google Workspace connection requires an OAuth Web client and matching redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://your-rifan-domain.example
