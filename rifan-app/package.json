    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "24.x"
