rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() in ['Super Admin', 'Admin'] ||
        request.auth.token.email == 'kmgabadi@gmail.com'
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /farmers/{farmerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      match /sensitive/{docId} {
        allow read, write: if isSignedIn();
      }
      match /interventions/{docId} {
        allow read, write: if isSignedIn();
      }
    }

    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /chatMessages/{messageId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /programs/{programId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /systemConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /warehouses/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /importStaging/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
